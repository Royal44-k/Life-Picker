# Only edit this file after copying it to .env; never put keys in browser code.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Optional: set a model you have already installed with Ollama.
OLLAMA_MODEL=
PORT=5173
# Optional video tools. Empty uses the project-local portable runtime or PATH.
FFMPEG_PATH=
FFPROBE_PATH=
