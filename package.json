{
  "name": "shiye-card-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --use-env-proxy server/index.mjs",
    "start": "node --use-env-proxy server/index.mjs --prod",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs",
    "assets": "node scripts/make-assets.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test tests/core.test.ts tests/ai.test.mjs",
    "test:e2e": "node tests/browser.mjs",
    "test:pwa": "node tests/pwa.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.577.0",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "playwright": "^1.61.1"
  }
}
